{
  "name": "loveneet-suite",
  "description": "Loveneet Suite Desktop Application",
  "author": "Loveneet Suite",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "electron .",
    "desktop:build": "vite build && electron-builder --dir",
    "desktop:dist": "vite build && electron-builder --win nsis",
    "desktop:publish": "vite build && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.loveneet.suite",
    "productName": "Loveneet Suite",
    "copyright": "Copyright © 2026 Loveneet Suite",
    "electronDist": "node_modules/electron/dist",
    "publish": [
      {
        "provider": "github",
        "owner": "loveneeta",
        "repo": "LoveneetSuite"
      }
    ],
    "directories": {
      "output": "../../dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/sql.js/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "LoveneetSuite-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loveneet Suite",
      "artifactName": "LoveneetSuite-Setup.exe",
      "uninstallDisplayName": "Loveneet Suite"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.15.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
